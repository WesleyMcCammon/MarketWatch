@using Microsoft.AspNetCore.Html
@model List<MarketWatch.Models.CurrencyPairViewModel>

@{
    ViewData["Title"] = "Currency Dashboard";
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script src="/js/dashboard.js"></script>
<style>

    .masonry-container {
        column-count: 7;
        column-gap: 1rem;
    }

    .masonry-item {
        break-inside: avoid;
        margin-bottom: 1rem;
    }

    .level-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
    }

    .level-row > span:nth-child(1) {
        width: 25%;
    }

    .level-row > span:nth-child(2) {
        width: 25%;
    }

    .level-row > span:nth-child(3) {
        width: 25%;
    }
    .positive {
        color: limegreen;
    }

    .negative {
        color: red;
    }

    .section-title {
        font-weight: bold;
        margin-top: 10px;
        margin-bottom: 5px;
        border-bottom: 1px solid #ddd;
    }

</style>

<div class="container-fluid">

    <h2 class="mb-4">
        Currency Pair Dashboard
    </h2>

    <div class="masonry-container">

        @foreach (var pair in Model)
        {
            <div class="masonry-item">

                <div class="card shadow-sm">

                    <div class="card-body">

                        <!-- Header -->

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <h4 class="mb-0">
                                    @pair.Symbol
                                </h4>

                                <small class="text-muted">
                                    @pair.Description
                                </small>
                            </div>

                            <div class="text-end">

                                <div>
                                    <strong>BID:</strong>

                                    <span id="bid-@pair.Symbol.Replace("/", "-")">
                                        @pair.Bid 
                                    </span>&nbsp;
                                </div>

                                <div>
                                    <strong>ASK:</strong>

                                    <span id="ask-@pair.Symbol.Replace("/", "-")">
                                        @pair.Ask
                                    </span>&nbsp;
                                </div>

                                <div class="@(pair.PercentChange >= 0 ? "positive" : "negative")">
                                    @pair.PercentChange %
                                </div>

                            </div>

                        </div>

                        <!-- Pivot Levels -->

                        <div class="section-title">
                            Pivot Levels
                        </div>

                        @{
                            var pivots = pair.IndicatorModels.Where(i => i.Name == "Pivot").First();
                            var r3 = pivots.IndicatorModelValues.Where(pair => pair.Name == "R3").First();
                            var r2 = pivots.IndicatorModelValues.Where(pair => pair.Name == "R2").First();
                            var r1 = pivots.IndicatorModelValues.Where(pair => pair.Name == "R1").First();
                            var pivot = pivots.IndicatorModelValues.Where(pair => pair.Name == "Pivot").First();
                            var s1 = pivots.IndicatorModelValues.Where(pair => pair.Name == "S1").First();
                            var s2 = pivots.IndicatorModelValues.Where(pair => pair.Name == "S2").First();
                            var s3 = pivots.IndicatorModelValues.Where(pair => pair.Name == "S3").First();

                            @RenderLevel(pair.Symbol, "R3", r3 != null ? r3.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "R2", r2 != null ? r2.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "R1", r1 != null ? r1.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Pivot", pivot != null ? pivot.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "S1", s1 != null ? s1.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "S2", s2 != null ? s2.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "S3", s3 != null ? s3.Value : 0m, pair.Bid)
                        }

                        <!-- Value Area -->

                        <div class="section-title">
                            Value Area
                        </div>

                        @{
                            var volumeProfile = pair.IndicatorModels.Where(i => i.Name == "Volume Profile").First();
                            var valueAreaHigh = volumeProfile.IndicatorModelValues.Where(pair => pair.Name == "Value Area High").First();
                            var pointOfControl = volumeProfile.IndicatorModelValues.Where(pair => pair.Name == "Point of Control").First();
                            var valueAreaLow = volumeProfile.IndicatorModelValues.Where(pair => pair.Name == "Value Area Low").First();
                            @RenderLevel(pair.Symbol, "VAH", valueAreaHigh != null ? valueAreaHigh.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "POC", pointOfControl != null ? pointOfControl.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "VAL", valueAreaLow != null ? valueAreaLow.Value : 0m, pair.Bid)
                        }

                        <!-- VWAP -->

                        <div class="section-title">
                            VWAP & Std Dev
                        </div>

                        @{
                            var vwapIndicator = pair.IndicatorModels.Where(i => i.Name == "VWAP").First();
                            var vwap = vwapIndicator.IndicatorModelValues.Where(pair => pair.Name == "VWAP").First();
                            var stdDevPlus1 = vwapIndicator.IndicatorModelValues.Where(pair => pair.Name == "Std Dev +1").First();
                            var stdDevPlus2 = vwapIndicator.IndicatorModelValues.Where(pair => pair.Name == "Std Dev +2").First();
                            var stdDevPlus3 = vwapIndicator.IndicatorModelValues.Where(pair => pair.Name == "Std Dev +3").First();
                            var stdDevMinus1 = vwapIndicator.IndicatorModelValues.Where(pair => pair.Name == "Std Dev -1").First();
                            var stdDevMinus2 = vwapIndicator.IndicatorModelValues.Where(pair => pair.Name == "Std Dev -2").First();
                            var stdDevMinus3 = vwapIndicator.IndicatorModelValues.Where(pair => pair.Name == "Std Dev -3").First();

                            @RenderLevel(pair.Symbol, "VWAP", vwap != null ? vwap.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Std Dev +1", stdDevPlus1 != null ? stdDevPlus1.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Std Dev +2", stdDevPlus2 != null ? stdDevPlus2.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Std Dev +3", stdDevPlus3 != null ? stdDevPlus3.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Std Dev -1", stdDevMinus1 != null ? stdDevMinus1.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Std Dev -2", stdDevMinus2 != null ? stdDevMinus2.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Std Dev -3", stdDevMinus3 != null ? stdDevMinus3.Value : 0m, pair.Bid)
                        }

                        <!-- Previous Day -->

                        <div class="section-title">
                            Previous Day
                        </div>
                        @{

                            var prevDayOHLC = pair.IndicatorModels.Where(i => i.Name == "Prev Day OHLC").First();
                            var prevOpen = prevDayOHLC.IndicatorModelValues.Where(pair => pair.Name == "Open").First();
                            var prevHigh = prevDayOHLC.IndicatorModelValues.Where(pair => pair.Name == "High").First();
                            var prevLow = prevDayOHLC.IndicatorModelValues.Where(pair => pair.Name == "Low").First();
                            var prevClose = prevDayOHLC.IndicatorModelValues.Where(pair => pair.Name == "Close").First();
                            @RenderLevel(pair.Symbol, "Prev Open", prevOpen != null ? prevOpen.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Prev High", prevHigh != null ? prevHigh.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Prev Low", prevLow != null ? prevLow.Value : 0m, pair.Bid)
                            @RenderLevel(pair.Symbol, "Prev Close", prevClose != null ? prevClose.Value : 0m, pair.Bid)
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>

@functions {

    public IHtmlContent RenderLevel(
        string symbol,
        string name,
        decimal level,
        decimal bid)
    {
    var diff = bid - level;

        var diffClass =
            diff >= 0
                ? "positive"
                : "negative";

        var safeSymbol =
            symbol.Replace("/", "-");

        var levelId =
            $"{safeSymbol}-{name.Replace(" ", "-")}";

        return new HtmlString($@"

        <div class='level-row'>

            <span>{name}</span>

            <span>
                {level:F5}
            </span>

            <span
                id='diff-{levelId}'
                class='{diffClass}'
                data-level='{level}'>

                {(diff >= 0 ? "+" : "")}
                {diff:F5}

            </span>

        </div>

    ");
    }

}
